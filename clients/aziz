#!/usr/bin/env bash
# aziz - launch Claude Code against the local Qwen3-VL-4B-Instruct server on
# the Vulkan box.
#
# No translation proxy involved: the llama.cpp Vulkan build serving this model
# exposes a native Anthropic-compatible /v1/messages endpoint. Only the base URL
# is redirected. Verified on 2026-08-24: id/type/role/content/stop_reason/usage.
#
# Scope: the exported variables live in this process only. A plain `claude` in
# another shell keeps talking to Anthropic.

set -euo pipefail

HOST="${LLM_HOST:-llm-server.local}"
PORT="8080"
BASE="http://${HOST}:${PORT}"
SSH_TARGET="${LLM_SSH_USER:-youruser}@${HOST}"
# llama-server on this box now requires its own API key (both x-api-key and
# Authorization: Bearer are accepted; verified 2026-08-25). /health stays open
# without it, but /props does not, so every /props probe below needs it too.
API_KEY="${LLM_API_KEY:?set LLM_API_KEY to the --api-key value used by llama-server}"
CTL='D:\LLM-Setup\llm-ctl.ps1'
ACTION="qwen3vl4b"
LOAD_TIMEOUT=180

# Matched against model_path from /props. Qwen3.5-9B and Qwen3.8-9B also sit on
# that box and are both barred: the first froze the whole machine on 2026-08-24
# and only a physical power cycle brought it back.
MODEL_MATCH="qwen3vl-4b"

# The server's window, and it must match the -c flag llama-server was started
# with. Claude Code's own prompt measures ~44_000 tokens without MCP, so any
# value below that makes a session impossible. Raise -c server-side FIRST, then
# this line: announcing a window the server does not have yields truncation, not
# an error.
#
# 81_920 is the largest context measured to hold on this card, with a q4_0 KV
# cache and 1_077 MiB of VRAM still free after a full-screen image goes through.
# The next step up, 98_304, left only 477 MiB and was rejected: VRAM exhaustion
# is what freezes this machine.
CONTEXT_TOKENS=81920

err() { printf '%s\n' "$*" >&2; }

is_up() { curl -sS -m 3 "${BASE}/health" 2>/dev/null | grep -q '"status":"ok"'; }

# Health answers ok even when no model is servable and whatever model sits on the
# port, so it proves nothing on its own: read model_path from /props.
loaded_model() {
  curl -sS -m 3 -H "Authorization: Bearer ${API_KEY}" "${BASE}/props" 2>/dev/null \
    | sed -n 's/.*"model_path":"\([^"]*\)".*/\1/p'
}

is_aziz() { loaded_model | grep -qi "$MODEL_MATCH"; }

# A scheduled task starts the server at boot, so an absent server means it died
# or was stopped by hand. llm-ctl.ps1 brings it back without touching the box.
load_aziz() {
  err "Loading Qwen3-VL-4B on ${HOST}..."
  ssh -o ConnectTimeout=10 "$SSH_TARGET" \
    "powershell -NoProfile -ExecutionPolicy Bypass -File ${CTL} -Action ${ACTION}" >&2

  local waited=0
  while (( waited < LOAD_TIMEOUT )); do
    if is_up && is_aziz; then
      err "Qwen3-VL-4B ready."
      return 0
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done

  err "Failed: the model did not answer within ${LOAD_TIMEOUT}s."
  err "See D:\\LLM-Setup\\llm-err-${ACTION}.log on ${HOST}."
  return 1
}

if ! is_up; then
  load_aziz
elif ! is_aziz; then
  err "Port ${PORT} is serving $(loaded_model | sed 's/.*\\//'), not ${MODEL_MATCH}."
  read -r -p "Replace it with Qwen3-VL-4B? [y/N] " answer
  [[ "$answer" =~ ^[yY]$ ]] || { err "Aborted."; exit 1; }
  load_aziz
fi

# AUTH_TOKEN and not API_KEY: the latter triggers Claude Code's custom-key
# approval prompt. llama-server now runs with --api-key set (Windows box moved
# off the "any bearer accepted" state on 2026-08-25); it checks the
# Authorization: Bearer header this produces (verified working against x-api-key
# too, but Bearer is what AUTH_TOKEN sends).
export ANTHROPIC_AUTH_TOKEN="$API_KEY"
export ANTHROPIC_BASE_URL="$BASE"

# Every model id resolves to the single loaded model, but naming them keeps the
# UI honest and stops Claude Code from reaching for a real Anthropic model.
export ANTHROPIC_MODEL="qwen3-vl-4b"
export ANTHROPIC_DEFAULT_OPUS_MODEL="qwen3-vl-4b"
export ANTHROPIC_DEFAULT_SONNET_MODEL="qwen3-vl-4b"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="qwen3-vl-4b"
export ANTHROPIC_SMALL_FAST_MODEL="qwen3-vl-4b"

export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$CONTEXT_TOKENS"

# A small output budget does NOT yield a short answer on this model: it yields an
# EMPTY one, and a slower turn. Measured on the same box: 200 tokens produced 777
# characters of reasoning and no text at all in 9.2 s, where 800 tokens produced
# the right answer in 2.2 s. Never lower this to save context.
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192

# Telemetry and update pings would otherwise be aimed at the local server.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# MCP servers are dropped: their 70 tool schemas weigh ~108 KB of prompt, which a
# window this size cannot afford. Skills, commands, memory and CLAUDE.md are
# untouched.
exec claude --strict-mcp-config --mcp-config '{"mcpServers":{}}' "$@"
